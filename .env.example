# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=development
LOG_LEVEL=info

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-value
JWT_ISSUER=secure-portfolio-copilot
JWT_AUDIENCE=secure-portfolio-web
JWT_ACCESS_TOKEN_MINUTES=15
# Set locally before running the development seed. Never reuse in production.
DEMO_USER_PASSWORD=choose-a-local-development-password

# --- Frontend ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- Database ---
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio_dev@127.0.0.1:5432/portfolio

# --- Development document storage ---
# Generated object keys are stored here. Browser-supplied paths are never accepted.
DOCUMENT_STORAGE_PATH=../.local/document-storage

# --- Local development embeddings ---
# Only explicit HTTP loopback targets are accepted. Automated tests override this with a fake.
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL_NAME=nomic-embed-text
EMBEDDING_MODEL_VERSION=v1.5
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_CHUNKS=512
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_OPERATION_TIMEOUT_SECONDS=120

# --- Grounded chat and agent model ---
# Set RUNPOD_API_KEY only in the ignored local .env. Never commit a real key.
LLM_PROVIDER=router
RUNPOD_API_KEY=replace-with-a-local-runpod-key
RUNPOD_BASE_URL=https://api.runpod.ai/v2/moonshot-kimi/openai/v1
RUNPOD_MODEL_NAME=kimi-k3
QWEN_BASE_URL=http://192.168.31.213:11434
QWEN_MODEL_NAME=qwen3:8b
QWEN_TIMEOUT_SECONDS=15
QWEN_MAX_OUTPUT_TOKENS=1024
ROUTER_LOW_CONFIDENCE_THRESHOLD=0.55
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_EVIDENCE_CHUNKS=5
# Optional Gemini alternative: select LLM_PROVIDER=gemini and set these locally.
# GEMINI_API_KEY=replace-with-a-local-gemini-key
# LLM_MODEL_NAME=gemini-3.7-flash
# LLM_THINKING_LEVEL=medium
AGENT_MAX_STEPS=4
AGENT_MAX_REPLANS=1
AGENT_MAX_RETRIEVAL_REWRITES=1
AGENT_MAX_DURATION_SECONDS=90
AGENT_TOOL_TIMEOUT_SECONDS=10
AGENT_TOOL_MAX_TRANSIENT_RETRIES=1

# --- MCP servers ---
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765

# --- Market data provider ---
MARKET_DATA_API_KEY=replace-me
