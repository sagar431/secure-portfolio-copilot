# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=development
LOG_LEVEL=info

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-value
JWT_ISSUER=secure-portfolio-copilot
JWT_AUDIENCE=secure-portfolio-web
JWT_ACCESS_TOKEN_MINUTES=15
# Set locally before running the development seed. Never reuse in production.
DEMO_USER_PASSWORD=choose-a-local-development-password

# --- Frontend ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- Database ---
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio_dev@127.0.0.1:5432/portfolio

# --- Development document storage ---
# Generated object keys are stored here. Browser-supplied paths are never accepted.
DOCUMENT_STORAGE_PATH=../.local/document-storage

# --- Local development embeddings ---
# Only explicit HTTP loopback targets are accepted. Automated tests override this with a fake.
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL_NAME=nomic-embed-text
EMBEDDING_MODEL_VERSION=v1.5
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_CHUNKS=512
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_OPERATION_TIMEOUT_SECONDS=120

# --- LLM provider ---
LLM_PROVIDER=
LLM_API_KEY=replace-me
LLM_MODEL=

# --- MCP servers ---
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765

# --- Market data provider ---
MARKET_DATA_API_KEY=replace-me
