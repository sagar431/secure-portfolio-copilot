# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=development
LOG_LEVEL=info

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-value
JWT_ISSUER=secure-portfolio-copilot
JWT_AUDIENCE=secure-portfolio-web
JWT_ACCESS_TOKEN_MINUTES=15
# Set locally before running the development seed. Never reuse in production.
DEMO_USER_PASSWORD=choose-a-local-development-password

# --- Frontend ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- Database ---
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio_dev@127.0.0.1:5432/portfolio

# --- LLM provider ---
LLM_PROVIDER=
LLM_API_KEY=replace-me
LLM_MODEL=

# --- MCP servers ---
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765

# --- Market data provider ---
MARKET_DATA_API_KEY=replace-me
